{
  "name": "claude-coding-mascot",
  "displayName": "Claude Coding Mascot",
  "description": "Drive your GitHub README coding mascot live — flips to 'coding' while you type and 'idle' when you stop.",
  "version": "0.1.0",
  "publisher": "blackscythe123",
  "license": "MIT",
  "icon": "icon.png",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["coding", "mascot", "readme", "status", "github", "claude", "crab"],
  "galleryBanner": { "color": "#17120E", "theme": "dark" },
  "homepage": "https://pet-zeta-gules.vercel.app",
  "repository": { "type": "git", "url": "https://github.com/blackscythe123/claude-readme-mascot" },
  "bugs": { "url": "https://github.com/blackscythe123/claude-readme-mascot/issues" },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "claudeMascot.generateKey", "title": "Claude Mascot: Generate Key & Link" },
      { "command": "claudeMascot.setKey", "title": "Claude Mascot: Set Key (paste existing)" },
      { "command": "claudeMascot.showKey", "title": "Claude Mascot: Show Key" },
      { "command": "claudeMascot.unlink", "title": "Claude Mascot: Unlink (clear key)" }
    ],
    "configuration": {
      "title": "Claude Coding Mascot",
      "properties": {
        "claudeMascot.baseUrl": {
          "type": "string",
          "default": "https://pet-zeta-gules.vercel.app",
          "description": "Base URL of your deployed mascot site."
        },
        "claudeMascot.idleTimeoutSeconds": {
          "type": "number",
          "default": 300,
          "description": "Seconds of inactivity before the mascot goes idle."
        }
      }
    }
  }
}
